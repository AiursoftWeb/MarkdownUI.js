{
  "name": "@aiursoft/uistack-markdown-ui",
  "version": "1.2.21",
  "description": "Shared, secure Markdown editing and reading utilities for Aiursoft applications.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/index.global.js"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "markdown-it": "14.3.3"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "26.1.0",
    "rimraf": "6.1.4",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.aiursoft.com/aiursoft/MarkdownUI.js.git"
  }
}
